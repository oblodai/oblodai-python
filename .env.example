# Oblodai credentials. SERVER SIDE ONLY - a secret must never reach a browser or a mobile app.
# Copy to `.env` and fill in your own values.
#
# Where it comes from: the Oblodai dashboard (https://oblodai.com), API keys section. The secret is
# shown ONCE when the key is created. For development take a sandbox key (public id `test_...`,
# secret `oblodai_test_...`): same endpoints, no real money.

# Required. One API key signs every route this SDK calls - payments, payouts, settings, documents
# alike. There is no second pair to configure.
OBLODAI_PUBLIC_ID=test_public_id_here
OBLODAI_SECRET=oblodai_test_secret_here

# Overrides the API origin (default https://api.oblodai.com). https only: over plain http the
# X-Signature header travels in the clear and the client refuses to start. The exception is a
# loopback stand (http://localhost:8095, http://127.0.0.1:8095).
# OBLODAI_BASE_URL=https://api.oblodai.com

# Permit a plain-http base URL that is not loopback (a self-hosted gateway behind a TLS terminator).
# OBLODAI_ALLOW_INSECURE=1

# Self-hosted gateways only: gates the merchant-provisioning routes (merchants.create).
# OBLODAI_ADMIN_TOKEN=

# Structured logging to stderr: debug | info | warning | error. Secrets are redacted.
# OBLODAI_LOG=debug

# Live test tier (pytest tests/live): the gateway to run it against, and an optional receiver the
# gateway can reach for the webhook scenario.
# OBLODAI_LIVE_URL=http://127.0.0.1:8095
# OBLODAI_LIVE_HOOK_URL=http://127.0.0.1:8096/hook
